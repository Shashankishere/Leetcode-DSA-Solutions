class Solution {
    vector<int> original;
    mt19937 rng{random_device{}()};
public:
    Solution(vector<int>& nums) {
        original = nums;
    }
    vector<int> reset() {
        return original;
    }
    vector<int> shuffle() {
        vector<int> arr = original;
        std::shuffle(arr.begin(), arr.end(), rng);
        return arr;
    }
};
