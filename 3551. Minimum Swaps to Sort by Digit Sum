class Solution {
public:
    int digitSum(int x) {
        int sum = 0;
        while (x) {
            sum += x % 10;
            x /= 10;
        }
        return sum;
    }
    int minSwaps(vector<int>& nums) {
        vector<int> target = nums;
        sort(target.begin(), target.end(), [&](int a, int b) {
            int x = digitSum(a), y = digitSum(b);
            if (x == y) return a < b;
            return x < y;
        });
        int n = nums.size(), swaps = 0;
        unordered_map<int, int> pos;
        for (int i = 0; i < n; i++)
            pos[nums[i]] = i;

        for (int i = 0; i < n; i++) {
            if (nums[i] == target[i])
                continue;
            int j = pos[target[i]];
            pos[nums[i]] = j;
            pos[nums[j]] = i;
            swap(nums[i], nums[j]);
            swaps++;
        }
        return swaps;
    }
};
