class Solution {
public:
    int garbageCollection(vector<string>& garbage, vector<int>& travel) {
        int n = garbage.size();
        for (int i = 1; i < n - 1; i++)
            travel[i] += travel[i - 1];
        int ans = 0;
        int lastM = -1, lastP = -1, lastG = -1;
        for (int i = 0; i < n; i++) {
            for (char c : garbage[i]) {
                ans++;
                if (c == 'M')
                    lastM = i;
                else if (c == 'P')
                    lastP = i;
                else
                    lastG = i;
            }
        }
        if (lastM > 0)
            ans += travel[lastM - 1];
        if (lastP > 0)
            ans += travel[lastP - 1];
        if (lastG > 0)
            ans += travel[lastG - 1];
        return ans;
    }
};
