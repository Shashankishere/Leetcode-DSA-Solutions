class Solution {
public:
    vector<int> relativeSortArray(vector<int>& arr1, vector<int>& arr2) {
        unordered_map<int, int> freq;
        for (int x : arr1)
            freq[x]++;
        vector<int> ans;
        for (int x : arr2) {
            while (freq[x] > 0) {
                ans.push_back(x);
                freq[x]--;
            }
            freq.erase(x);
        }
        vector<int> rem;
        for (auto &p : freq) {
            while (p.second > 0) {
                rem.push_back(p.first);
                p.second--;
            }
        }
        sort(rem.begin(), rem.end());
        ans.insert(ans.end(), rem.begin(), rem.end());
        return ans;
    }
};
