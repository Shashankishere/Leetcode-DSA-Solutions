class Solution {
public:
    string longestPrefix(string s) {
        int n = s.size();
        vector<int> lps(n, 0);
        for (int i = 1, j = 0; i < n;) {
            if (s[i] == s[j]) {
                lps[i++] = ++j;
            } else if (j > 0) {
                j = lps[j - 1];
            } else {
                i++;
            }
        }
        return s.substr(0, lps[n - 1]);
    }
};
